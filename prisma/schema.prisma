// Prisma schema for Seguros (Insurance) platform
// Portable: designed so it can be migrated to Cloudflare D1 with minimal changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Policy {
  id            String   @id @default(cuid())
  // Public-facing verification code (short, used in QR /v/CODE)
  verifyCode    String   @unique
  policyNumber  String?  // assigned by admin on approval (e.g. 576501)

  // --- Status ---
  // PENDIENTE (requested, not yet approved) | APROBADA | RECHAZADA | ANULADA
  status        String   @default("PENDIENTE")
  notes         String?  // internal admin notes

  // --- Asegurado (insured person) ---
  asegNombre      String?
  asegApellido    String?
  asegCedula      String?
  asegEmail       String?

  // --- Tomador (policyholder) ---
  tomadorIgualAseg  String? @default("Si") // "Si" or "No"
  tomNombre       String?
  tomApellido     String?
  tomCedula       String?
  tomEmail        String?
  tomFechaNacimiento String?
  tomEstadoCivil  String?
  tomGenero       String?
  tomTelefono     String?
  tomEstado       String?
  tomMunicipio    String?
  tomParroquia    String?
  tomDireccion    String?

  // --- Legacy personal fields (kept for backward compat) ---
  nombre        String
  apellido      String?
  cedula        String
  tipoCedula    String?
  fechaNacimiento String?
  nacionalidad  String?
  estadoCivil   String?
  sexo          String?
  telefono      String?
  telefonoAlt   String?
  email         String?
  direccion     String?
  ciudad        String?
  estado        String?
  ocupacion     String?

  // --- Vehicle data ---
  tipoVehiculo  String?
  marca         String?
  modelo        String?
  ano           String?
  placa         String?
  color         String?
  serialCarroceria String?
  serialMotor   String?
  uso           String?
  capacidad     String?
  clase         String?
  tipo          String?
  poseeTrailer    String? @default("No")
  placaExtranjera String? @default("No")
  cantidadPuestos String?
  capacidadCarga  String?  // in Kg

  // --- Policy / coverage data ---
  vehicleClassId String?  // FK to VehicleClass
  planId         String?  // FK to Plan
  tipoCobertura String?
  compania      String?
  plan          String?
  prima         String?
  primaEur      String?
  primaUsd      String?
  primaBs       String?
  sumaAsegurada String?
  deducible     String?
  vigenciaDesde String?
  vigenciaHasta String?
  frecuenciaPago String?

  // --- Document references ---
  cedulaDocPath     String?
  cedulaDocName     String?
  cedulaDocType     String?
  tituloDocPath     String?
  tituloDocName     String?
  tituloDocType     String?

  // --- Generated artifacts ---
  pdfPath        String?
  qrPath         String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  aprobadoAt     DateTime?
  aprobadoPor    String?

  documents      Document[]
  activities     ActivityLog[]
  vehicleClass   VehicleClass? @relation(fields: [vehicleClassId], references: [id])
  planRef        Plan?         @relation(fields: [planId], references: [id])
}

model VehicleClass {
  id            String   @id @default(cuid())
  code          Int      @unique  // numeric code from the original system (39, 33, 25, ...)
  name          String   @unique  // "AUTO ESCUELA", "AUTOBUSES", "CARGA", etc.
  sortOrder     Int      @default(0)
  plans         Plan[]
  policies      Policy[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Plan {
  id            String   @id @default(cuid())
  externalId    Int      @unique  // original numeric ID (2, 3, 4, ...)
  name          String   // "PLAN LIDER MOTO", etc.
  vehicleClassId String
  vehicleClass  VehicleClass @relation(fields: [vehicleClassId], references: [id], onDelete: Cascade)
  priceEur      String   // "15.00"
  priceUsd      String   // "17.31"
  priceBs       String   // "13,276.20"
  active        Boolean  @default(true)
  policies      Policy[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Document {
  id            String   @id @default(cuid())
  policyId      String
  policy        Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  tipo          String   // CEDULA | TITULO | OTRO
  fileName      String
  filePath      String   // bucket path
  mimeType      String
  size          Int?
  createdAt      DateTime @default(now())
}

model ActivityLog {
  id            String   @id @default(cuid())
  policyId      String
  policy        Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  action        String   // CREATED | UPDATED | APPROVED | REJECTED | DOCUMENT_UPLOADED | DOCUMENT_DELETED | STATUS_CHANGED | PDF_GENERATED
  description   String
  actor         String   @default("system")
  metadata      String?  // JSON string with changed fields, etc.
  createdAt     DateTime @default(now())
}

model Setting {
  id            String   @id @default(cuid())
  key           String   @unique  // ASEGURADORAS | COVERAGE_TYPES | VEHICLE_TYPES | PLAN_TYPES | APP_CONFIG
  value         String   // JSON string
  updatedAt     DateTime @updatedAt
}
